# 端口号
PORT=8080

# 图片根目录
GALLERY_ROOT=/gallery

# 管理员用户名
ADMIN_USER=admin

# 管理员初始密码（首次启动后应修改）
ADMIN_PASSWORD=admin

# 会话密钥（生产环境应该设置为随机字符串）
# SESSION_SECRET=your-random-secret-here

# 缩略图缓存目录
THUMB_DIR=/app/data/thumbs

# 缩略图大小（像素）
THUMB_SIZE=320

# 缩略图质量 (1-100)
THUMB_QUALITY=80

# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info

# 运行环境 (development, production)
NODE_ENV=development
